<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:i18n="http://namespaces.zope.org/i18n"
  xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
  i18n_domain="genweb">

  <genericsetup:upgradeStep
      title="Reinstall genweb6.upc"
      description="Reinstall package genweb6.upc"
      source="*"
      destination="*"
      handler="genweb6.upc.upgrades.upgrade_by_reinstall"
      profile="genweb6.upc:default"
      />

  <genericsetup:upgradeDepends
      title="Add Google Maps API Key"
      description="Register google_maps_api_key field in UPC contact settings"
      source="1000"
      destination="1001"
      import_steps="plone.app.registry"
      profile="genweb6.upc:default"
      />

</configure>